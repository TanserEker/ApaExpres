NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Sadece sunucu tarafı / güvenilir kodda (server action, admin paneli, cron/webhook)
# kullanılmalı. Tarayıcıya asla göndermeyin — RLS'yi tamamen atlar.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Web Push (VAPID) — Görev 7, opsiyonel sipariş durum bildirimleri. Tanımlı
# değilse bildirim gönderimi sessizce atlanır (bkz. src/lib/web-push.ts),
# siteyi bloklamaz. Üretmek için: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=your-vapid-public-key
VAPID_PRIVATE_KEY=your-vapid-private-key
VAPID_SUBJECT=mailto:info@deef-tech.com
